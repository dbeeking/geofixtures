{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geofixtures.dev/schemas/manifest-v1.schema.json",
  "title": "GeoFixtures case manifest",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "case_version",
    "title",
    "category",
    "tags",
    "operation",
    "expected_status",
    "generator",
    "seed",
    "parameters",
    "inputs",
    "truth",
    "assertions",
    "tolerances",
    "files",
    "license",
    "references"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+\\.[0-9]{3}$"
    },
    "case_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "vector",
        "crs",
        "raster",
        "landcover",
        "lidar",
        "ingestion"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "expected_status": {
      "enum": [
        "success",
        "rejection",
        "uncertain"
      ]
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "seed": {
      "type": "integer"
    },
    "generator_parameters": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "format",
          "profile"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "crs": {
            "type": "string"
          },
          "acquired": {
            "type": "string"
          }
        }
      }
    },
    "truth": {
      "type": "object",
      "required": [
        "method",
        "path",
        "review_status",
        "derivation"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "review_status": {
          "enum": [
            "pending_independent_review",
            "independently_verified",
            "annotated"
          ]
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "exact",
              "set_equal",
              "numeric",
              "geometry_equivalent",
              "topology_predicate",
              "raster_metadata",
              "raster_values",
              "classification_metrics",
              "pointcloud_metadata",
              "schema",
              "expected_error",
              "invariant"
            ]
          },
          "observe": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "numeric"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "unit"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "exact"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "expected"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "set_equal"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "expected"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "geometry_equivalent"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "expected",
                "policy",
                "require_valid"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "topology_predicate"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "expected"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "raster_metadata"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "expected"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "raster_values"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "truth",
                "absolute_tolerance",
                "unit",
                "truth_nodata"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "classification_metrics"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "truth",
                "labels",
                "class_names",
                "ignore_values",
                "abstain_values",
                "zero_division",
                "averaging",
                "thresholds"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "pointcloud_metadata"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "expected"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "schema"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "expected"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "invariant"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "rule"
              ]
            }
          }
        ]
      }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "identifier",
        "redistributable"
      ],
      "properties": {
        "identifier": {
          "type": "string"
        },
        "redistributable": {
          "type": "boolean"
        }
      }
    },
    "references": {
      "type": "array"
    },
    "environment": {
      "type": "object"
    }
  }
}
